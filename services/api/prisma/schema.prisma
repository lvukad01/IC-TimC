generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole{
  CLIENT
  SALON_OWNER
  ADMIN
}

enum EmployeeRole{
  HAIRDRESSER
  NAIL_TECH
  MAKEUP_ARTIST
  BARBER
}

enum SalonStatus{
  ACTIVE
  PENDING
  SUSPENDED
}

enum MediaType{
  PROFILE
  GALLERY
}

enum SalonCategory{
  HAIR
  NAILS
  MAKEUP
  BARBERSHOP
}

enum BookingStatus{
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod{
  CARD 
  CASH 
  PAYPAL
}

enum PaymentType{
  DEPOSIT 
  FULL
}

enum PaymentStatus{
  PENDING
  PAID 
  REFUNDED 
  FAILED
}

enum NotificationType{
  CONFIRMATION
  REMINDER
  CANCELLED
}

model ServiceCategories{
  id String @id @default(uuid())
  name String @unique
  slug String @unique

  services Services[]
}

model Users{
  id String @id @default(uuid())
  email String @unique
  firstName String 
  lastName String
  password String
  phone String?
  role UserRole @default(CLIENT)
  city String
  zipcode String
  country String
  street String
  lat Float?
  lng Float?
  createdAt DateTime @default(now())

  salons Salons[]
  bookings Bookings[]
  reviews Reviews[]
  notifications Notifications[]
  paymentTransactions PaymentTransactions[]
}

model Salons{
  id String @id @default(uuid())
  ownerId String
  name String 
  country String
  city String
  zipcode String
  street String
  lat Float?
  lng Float?
  status SalonStatus @default(PENDING)
  createdAt DateTime @default(now())

  owner Users @relation(fields: [ownerId], references: [id])
  media SalonMedia[]
  categories SalonCategories[]
  services Services[]
  employees Employees[]
  bookings Bookings[]
  reviews Reviews[]
}

model SalonMedia{
  id String @id @default(uuid())
  salonId String
  key String
  type MediaType @default(PROFILE)
  sortOrder Int
  createdAt DateTime @default(now())

  salon Salons @relation(fields: [salonId], references: [id])
}

model SalonCategories{
  id String @id @default(uuid())
  salonId String
  category SalonCategory

  salon Salons @relation(fields: [salonId], references: [id])
}

model Services{
  id String @id @default(uuid())
  salonId String
  categoryId String
  name String
  price Decimal
  durationMin Int
  isActive Boolean @default(true)

  salon Salons @relation(fields: [salonId], references: [id])
  category ServiceCategories @relation(fields: [categoryId], references: [id])
  employeeServices EmployeeServices[]
  bookings Bookings[]
}

model Employees{
  id String @id @default(uuid())
  salonId String 
  name String
  role EmployeeRole 
  isActive Boolean @default(true)

  salon Salons @relation(fields: [salonId], references: [id])
  employeeServices EmployeeServices[]
  bookings Bookings[]
  workingHours WorkingHours[]
  timeOffs TimeOff[]
}

model EmployeeServices{
  employeeId String
  serviceId String

  employee Employees @relation(fields: [employeeId], references: [id])
  service Services @relation(fields: [serviceId], references: [id])

  @@id([employeeId, serviceId])
}

model WorkingHours{
  id String @id @default(uuid())
  employeeId String
  dayOfWeek Int
  startTime String
  endTime String

  employee Employees @relation(fields: [employeeId], references: [id])
}

model TimeOff{
  id String @id @default(uuid())
  employeeId String
  startDatetime DateTime
  endDatetime DateTime
  reason String?

  employee Employees @relation(fields: [employeeId], references: [id])
}

model Bookings{
  id String @id @default(uuid())
  clientId String
  salonId String
  serviceId String
  employeeId String
  startTime DateTime
  endTime DateTime
  status BookingStatus @default(PENDING)
  createdAt DateTime @default(now())

  client Users @relation(fields: [clientId], references: [id])
  salon Salons @relation(fields: [salonId], references: [id])
  service Services @relation(fields: [serviceId], references: [id])
  employee Employees @relation(fields: [employeeId], references: [id])
  payments Payments[]
  review Reviews?
}

model Payments{
  id String @id @default(uuid())
  bookingId String
  amount Decimal
  method PaymentMethod
  type PaymentType
  status PaymentStatus @default(PENDING)
  externalId String?
  createdAt DateTime @default(now())

  booking Bookings @relation(fields: [bookingId], references: [id])
  transactions PaymentTransactions[]
}

model PaymentTransactions{
  id String @id @default(uuid())
  paymentId String
  initiatedBy String
  type String
  amount Decimal
  status String
  createdAt DateTime @default(now())
  notes String?

  payment Payments @relation(fields: [paymentId], references: [id])
  initiator Users @relation(fields: [initiatedBy], references: [id])
}

model Reviews{
  id String @id @default(uuid())
  bookingId String @unique
  clientId String
  salonId String
  rating Int
  comment String?
  createdAt DateTime @default(now())

  booking Bookings @relation(fields: [bookingId], references: [id])
  client Users @relation(fields: [clientId], references: [id])
  salon Salons @relation(fields: [salonId], references: [id])
}

model Notifications{
  id String @id @default(uuid())
  userId String
  type NotificationType
  content String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  user Users @relation(fields: [userId], references: [id])
}